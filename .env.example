# ── Public build-time configuration ────────────────────────────────
# These NEXT_PUBLIC_* values are inlined when `next build` runs, so set
# them BEFORE building. Copy this file to `.env.local` for local builds.

# Canonical public origin used by canonical links, hreflang, Open Graph,
# robots.txt and sitemap.xml. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://fitness-calculators.com

# Contact address shown on the privacy-policy page (GDPR/CCPA requests).
NEXT_PUBLIC_CONTACT_EMAIL=privacy@fitness-calculators.com
